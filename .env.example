# Dobot Robot Configuration — copy to .env and fill in. .env is gitignored.

# Robot IP address (wired default 192.168.5.1; on the lab VLAN 10.11.6.68)
ROBOT_IP=192.168.5.1
# Robot model: cr3, cr5, cr7, cr10, cr12, cr16, cr20
ROBOT_TYPE=cr5

# --- dashboard sign-in (the shared homelab-auth package; homelab-system-ui §7) ---
# Signs the session cookie. Required unless AUTH_DISABLED=true (an open bench, never shipped).
SESSION_SECRET=
# break-the-glass local "admin" (works with AD down); empty = disabled
ADMIN_PASSWORD=
AUTH_DISABLED=false
AD_ENABLED=true
AD_SERVER=ldap://dcrbr1.siegel.com
AD_BASE_DN=DC=siegel,DC=com
AD_DOMAIN=siegel.com
# a successful AD login is not enough: membership here is the gate (admins drive the arm)
AD_ADMIN_GROUP=Domain Admins
# Kerberos keytab holding HTTP/jupiter.siegel.com (secrets/http-jupiter.keytab, mounted
# read-only). Empty = browser SSO off, password form only. One host keytab serves every
# console on jupiter: copy go2's. Runbook: doorman's docs/SSO.md on harbr2.
SSO_KEYTAB=/app/secrets/http-jupiter.keytab
